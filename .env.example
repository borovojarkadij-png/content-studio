# Create .env locally; never commit secrets.
POSTGRES_DB=newsflow
POSTGRES_USER=newsflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://newsflow:change-me@postgres:5432/newsflow
REDIS_URL=redis://redis:6379/0
NEWSFLOW_REWRITE_ENABLED=0
# Requires a qualified fixed-model release and explicit per-channel VERIFIED policy.
# Does not enable Telegram transport; unqualified models cannot auto-approve.
NEWSFLOW_SEMANTIC_VERIFICATION_ENABLED=0
NEWSFLOW_INTERNET_MEDIA_ENABLED=0
NEWSFLOW_TELEGRAM_INGESTION_ENABLED=0
# Read-only downloads only with explicitly declared mapping rights and approved drafts.
# Requires the same optional Telegram credential mount; never enables publication.
NEWSFLOW_SOURCE_PHOTO_ENABLED=0
# Optional compose.telegram.yaml mounts an existing api_id/api_hash JSON secret.
# Authorization/session provisioning must happen explicitly; this never logs in.
# NEWSFLOW_TELEGRAM_CREDENTIALS_SOURCE=./secrets/telegram_credentials.json
# Explicit choice only; OPENROUTER never falls back to paid OpenAI.
NEWSFLOW_REWRITE_PROVIDER=OPENAI
# Must be a stable 32-byte base64 secret. Do not regenerate after data exists.
NEWSFLOW_MASTER_KEY=
# Non-Compose runtime: set an existing persistent media directory, not a container temp path.
# Compose supplies its shared persistent media_data mount automatically.
NEWSFLOW_MEDIA_ROOT=
