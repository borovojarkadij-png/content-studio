# Create .env locally; never commit secrets.
POSTGRES_DB=newsflow
POSTGRES_USER=newsflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://newsflow:change-me@postgres:5432/newsflow
REDIS_URL=redis://redis:6379/0
NEWSFLOW_REWRITE_ENABLED=0
# Explicit choice only; OPENROUTER never falls back to paid OpenAI.
NEWSFLOW_REWRITE_PROVIDER=OPENAI
# Must be a stable 32-byte base64 secret. Do not regenerate after data exists.
NEWSFLOW_MASTER_KEY=
# Non-Compose runtime: set an existing persistent media directory, not a container temp path.
# Compose supplies its shared persistent media_data mount automatically.
NEWSFLOW_MEDIA_ROOT=
